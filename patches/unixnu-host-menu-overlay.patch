+// Diagnostic snapshot only. No assumed high-RAM range is added to the firmware map.
+STATIC VOID MarbleMemorySnapshot (VOID)
+{
+  EFI_MEMORY_DESCRIPTOR *Map;
+  UINTN Bytes = 0, Key, Stride = 0, Capacity, Offset, Count = 0;
+  UINT32 Version;
+  EFI_STATUS Status;
+  Status = gBS->GetMemoryMap (&Bytes, NULL, &Key, &Stride, &Version);
+  if (Status != EFI_BUFFER_TOO_SMALL || Bytes > 0x80000 || Stride < sizeof (*Map)) {
+    UniXNULog ("UXTRACE memory-map query %r", Status); return;
+  }
+  Capacity = Bytes + 4096;
+  Map = AllocatePool (Capacity);
+  if (Map == NULL) return;
+  Bytes = Capacity;
+  Status = gBS->GetMemoryMap (&Bytes, Map, &Key, &Stride, &Version);
+  UniXNULog ("UXTRACE memory-map snapshot %r stride=%lu bytes=%lu (buffer allocated)", Status, Stride, Bytes);
+  if (!EFI_ERROR (Status) && Bytes <= Capacity && Stride >= sizeof (*Map)) {
+    for (Offset = 0; Offset + Stride <= Bytes && Count < 256; Offset += Stride, Count++) {
+      EFI_MEMORY_DESCRIPTOR *D = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Map + Offset);
+      UniXNULog ("UXTRACE mem type=%u base=0x%lx pages=0x%lx attr=0x%lx", D->Type, D->PhysicalStart, D->NumberOfPages, D->Attribute);
+    }
+    if (Offset < Bytes) UniXNULog ("UXTRACE memory-map truncated");
+  }
+  FreePool (Map);
 }
 
