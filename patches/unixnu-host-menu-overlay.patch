+def rewrite_host_tool_paths(root):
+    # This lane uses private shims, avoiding global /usr/bin replacements.
+    # This function runs only in the Linux preparation path.
+    path = root / 'makedefs/MakeInc.cmd'
+    text = path.read_text()
+    updated = text
+    for name in ('xcrun', 'plutil', 'codesign'):
+        updated = updated.replace('/usr/bin/' + name, name)
+    if updated != text:
+        path.write_text(updated)
+        info('resolved XNU host shims through lane-local PATH')
+
+
+def rewrite_csh_interpreters(root):
+    # GNU env -S retains csh's -f flag while finding the private tcsh on PATH.
+    for path in (root / 'SETUP').rglob('*'):
+        if not path.is_file():
+            continue
+        data = path.read_bytes()
+        old = b'#!/bin/csh -f\n'
+        if data.startswith(old):
+            path.write_bytes(b'#!/usr/bin/env -S tcsh -f\n' + data[len(old):])
+            info(f'resolved private tcsh for {path.relative_to(root)}')
+
+
 def rewrite_sources():
