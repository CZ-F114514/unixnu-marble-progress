@@ -0,0 +1,43 @@
+/* Local marble diagnostic candidate. Volatile RAM only, never a disk writer. */
+#ifndef MARBLE_RAM_LOG_H
+#define MARBLE_RAM_LOG_H
+#define MARBLE_LOG_MAGIC 0x31474F4CUL /* LOG1 */
+#define MARBLE_LOG_CAPACITY (0x10000 - 64)
+typedef struct {
+  UINT32 Magic;
+  UINT32 Version;
+  UINT64 Total;
+  UINT64 EntryFdt;
+  UINT64 EntryEl;
+  UINT64 Reserved[4];
+  UINT8 Data[MARBLE_LOG_CAPACITY];
+} MARBLE_RAM_LOG;
+#ifndef MARBLE_LOG_PTR
+#define MARBLE_LOG_PTR ((volatile MARBLE_RAM_LOG *)(UINTN)0xA75F0000)
+#endif
+STATIC inline VOID MarbleLogReset(UINT64 Fdt, UINT64 El) {
+  volatile MARBLE_RAM_LOG *Log = MARBLE_LOG_PTR;
+  Log->Magic = 0;
+  Log->Version = 1;
+  Log->Total = 0;
+  Log->EntryFdt = Fdt;
+  Log->EntryEl = El;
+  for (UINTN I = 0; I < 4; I++) Log->Reserved[I] = 0;
+  Log->Magic = MARBLE_LOG_MAGIC;
+}
+/* Caller serializes writes by masking local IRQs; diagnostic firmware uses BSP only. */
+STATIC inline VOID MarbleLogAppend(CONST UINT8 *Data, UINTN Size) {
+  volatile MARBLE_RAM_LOG *Log = MARBLE_LOG_PTR;
+  if (Log->Magic != MARBLE_LOG_MAGIC || Log->Version != 1) return;
+  for (UINTN I = 0; I < Size; I++) {
+    UINT64 At = Log->Total;
+    Log->Data[At % MARBLE_LOG_CAPACITY] = Data[I];
+    Log->Total = At + 1;
+  }
+}
+STATIC inline VOID MarbleLogStage(UINTN Stage) {
+  volatile MARBLE_RAM_LOG *Log = MARBLE_LOG_PTR;
+  if (Log->Magic == MARBLE_LOG_MAGIC && Log->Version == 1 && Stage < 64)
+    Log->Reserved[0] |= (UINT64)1 << Stage;
+}
+#endif
